{
  "id": "readiness1-native-controller",
  "name": "Readiness #1 native controller",
  "description": "Fail-closed OpenClaw 2026.10.3 public adapter around the canonical Readiness #1 authority with fixture-only Readiness #2 and offline-only Readiness #3 source; production execution and GitHub mutation remain unavailable.",
  "categories": [
    "agent-orchestration"
  ],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "controllerAgents",
      "controllerSessionKeys",
      "workerAgentId",
      "ownerDevicePins",
      "ownerSenderId",
      "ownerSessionKeys",
      "ownerTarget",
      "controllerDeviceId",
      "cliVersions",
      "dispatchReservation",
      "notification",
      "tasks"
    ],
    "properties": {
      "controllerAgents": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "controllerSessionKeys": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "workerAgentId": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "ownerDevicePins": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "ownerSenderId": { "type": "string", "minLength": 1 },
      "ownerSessionKeys": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "ownerTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "accountId", "recipientId"],
        "properties": {
          "channel": { "type": "string", "minLength": 1 },
          "accountId": { "type": "string", "minLength": 1 },
          "recipientId": { "type": "string", "minLength": 1 }
        }
      },
      "controllerDeviceId": { "type": "string", "minLength": 1 },
      "cliVersions": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claude-code", "codex"],
        "properties": {
          "claude-code": { "type": "string", "minLength": 1 },
          "codex": { "type": "string", "minLength": 1 }
        }
      },
      "dispatchReservation": { "type": "integer", "minimum": 1 },
      "notification": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceRepos", "taskRateCap"],
        "properties": {
          "evidenceRepos": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
          },
          "taskRateCap": { "type": "integer", "minimum": 1 }
        }
      },
      "tasks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "indexDigest", "instructions", "sourceRoot", "worktreeBranch", "worktreeName"],
          "properties": {
            "contract": { "type": "object" },
            "indexDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "instructions": { "type": "string", "minLength": 1, "maxLength": 65536 },
            "sourceRoot": { "type": "string", "pattern": "^/" },
            "worktreeBranch": { "type": "string", "minLength": 1, "maxLength": 256 },
            "worktreeName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
          }
        }
      }
    }
  },
  "version": "0.7.0",
  "contracts": {
    "tools": [
      "readiness1_task"
    ]
  }
}
